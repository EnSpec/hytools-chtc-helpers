# Interactive build job for the Apptainer image. From ~/<project>/chtc on the
# access point:
#
#   condor_submit -i build_container.sub
#   apptainer build hytools_<date>.sif hytools.def
#   exit
#   mv hytools_<date>.sif /staging/<first letter of your NetID>/<your NetID>/
#
# The .sif is ~1.5 GB and takes 5-10 minutes to build.

log = build_container.log

transfer_input_files = hytools.def

+IsBuildJob = True

request_cpus = 4
request_memory = 8GB
request_disk = 20GB

queue
